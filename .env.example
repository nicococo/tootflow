# App
SECRET_KEY=changeme-generate-a-long-random-string
# SQLite (dev):  sqlite:///./tootflow.db
# PostgreSQL:    postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./tootflow.db

# Campaign limits
MAX_POSTS_PER_CAMPAIGN=32

# Metrics collection limits (paid campaigns only)
METRICS_MAX_DAYS=30
METRICS_MAX_POSTS_PER_USER=100

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_POSTS_PER_CAMPAIGN=30
OPENAI_MAX_TOKENS=4096

# LemonSqueezy
LEMONSQUEEZY_API_KEY=...
LEMONSQUEEZY_STORE_ID=...
LEMONSQUEEZY_PRODUCT_VARIANT_ID=...
LEMONSQUEEZY_WEBHOOK_SECRET=...

# App URL (used for OAuth callbacks and webhooks)
APP_BASE_URL=https://tootflow.com

# Set to "production" to enable Secure cookie flag (requires HTTPS)
APP_ENV=production

# Admin analytics dashboard (leave empty to disable /admin)
ADMIN_SECRET=

# Legal / Impressum (required for impressum, privacy, and ToS pages)
OPERATOR_NAME=Firstname Lastname
OPERATOR_STREET=Musterstraße 1
OPERATOR_CITY=12345 Berlin
OPERATOR_PHONE=+49 30 12345678
# Umsatzsteuer-Identifikationsnummer (leave empty if Kleinunternehmer per §19 UStG applies)
OPERATOR_VAT_ID=DE123456789
OPERATOR_EMAIL=hello@tootflow.com

# Campaign pricing (display-only — actual charge is set in LemonSqueezy)
CAMPAIGN_PRICE=29
CAMPAIGN_CURRENCY=EUR
