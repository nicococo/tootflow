# App
SECRET_KEY=changeme-generate-a-long-random-string
# SQLite (dev):  sqlite:///./tootflow.db
# PostgreSQL:    postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./tootflow.db

# Campaign limits
MAX_POSTS_PER_CAMPAIGN=32
# Max non-archived campaigns per user (anti-abuse cap for hosted instances)
MAX_FREE_CAMPAIGNS=5

# Metrics collection limits
METRICS_MAX_DAYS=30
METRICS_MAX_POSTS_PER_USER=100

# AI (instance default). Users can bring their own key on the Account page
# (any OpenAI-compatible endpoint: OpenAI, OpenRouter, Ollama, ...), which
# takes precedence over this key.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_POSTS_PER_CAMPAIGN=30
OPENAI_MAX_TOKENS=4096

# X.com (Twitter) — OAuth 1.0a consumer credentials from the X Developer Portal
# (app must have Read+Write permissions; callback URL: <APP_BASE_URL>/x/callback)
# Leave empty to disable X support (UI hidden). Free tier is write-only (no metrics).
X_API_KEY=
X_API_SECRET=

# App URL (used for OAuth callbacks)
APP_BASE_URL=https://tootflow.com

# Set to "production" to enable Secure cookie flag (requires HTTPS)
APP_ENV=production

# Admin analytics dashboard (leave empty to disable /admin)
ADMIN_SECRET=

# Legal / Impressum (optional — pages hide themselves when left empty)
OPERATOR_NAME=
OPERATOR_STREET=
OPERATOR_CITY=
OPERATOR_PHONE=
OPERATOR_VAT_ID=
OPERATOR_EMAIL=
